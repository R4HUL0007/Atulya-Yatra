# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Google Places / Maps ----------------------------------------------------
# Enables live place discovery and directions. Without it the site falls back to
# the curated JSON in data/ and still works.
GOOGLE_MAPS_API_KEY=

# --- Optional language model -------------------------------------------------
# Used ONLY to reword facts the app already holds, never to generate place data.
# Leave blank to keep the assistant fully deterministic and offline.
# Set one of the following; the provider is detected automatically.
GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional overrides.
# ATULYA_LLM_PROVIDER=gemini|openai|none
# ATULYA_LLM_MODEL=gemini-flash-lite-latest
# ATULYA_LLM_TIMEOUT=20

# --- Admin area --------------------------------------------------------------
# The admin routes fail closed unless all three are set.
ATULYA_SECRET_KEY=
ATULYA_ADMIN_USERNAME=
ATULYA_ADMIN_PASSWORD_HASH=
